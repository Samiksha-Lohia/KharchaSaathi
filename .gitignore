# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's machine and should not be shared.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms/python versions,
#   Pipfile.lock might produce conflict.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions of dependencies.
#   You can decide to commit or ignore it.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions of dependencies.
#pdm.lock

