# PostgreSQL database connection URL (e.g. postgresql://postgres:postgres@localhost:5432/kharchasaathi)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/kharchasaathi

# Redis connection URL (e.g. redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Cloud API credentials
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=your_arbitrary_webhook_verify_token_here

# LLM Providers (Groq or OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Voice transcription API key (falls back to Groq API Key if using Groq Whisper)
WHISPER_API_KEY=your_whisper_api_key_here
